{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Pokemon Manager API",
    "description": "API para gerenciamento de Pokémons em catálogo local"
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Endpoints de gerenciamento de Pokémons"
    },
    {
      "name": "Pokedex",
      "description": "Endpoints de consulta à PokéAPI externa"
    },
    {
      "name": "Trainers",
      "description": "Endpoints de gerenciamento de treinadores e capturas"
    }
  ],
  "paths": {
    "/api/v1/pokedex/search": {
      "get": {
        "tags": [
          "Pokedex"
        ],
        "summary": "Consulta Pokémon na PokéAPI",
        "description": "Endpoint para consultar diretamente a PokéAPI externa pelo nome do Pokémon.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Nome do Pokémon",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon retornado com sucesso pela PokéAPI.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PokeApiPokemonDto"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista todos os Pokémons",
        "description": "Endpoint para listar Pokémons cadastrados, com filtro opcional por tipo.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Tipo do Pokémon para filtro",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de Pokémons retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pokemon"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cria um novo Pokémon",
        "description": "Endpoint para cadastrar manualmente um Pokémon no catálogo local.",
        "responses": {
          "201": {
            "description": "Pokémon criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon criado com sucesso!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePokemonDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um Pokémon por ID",
        "description": "Endpoint para buscar um Pokémon cadastrado pelo ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza um Pokémon",
        "description": "Endpoint para atualizar os dados de um Pokémon cadastrado no catálogo local.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon atualizado com sucesso!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePokemonDto"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon",
        "description": "Endpoint para remover um Pokémon do catálogo local.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon removido com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon removido com sucesso!"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Cria um novo treinador",
        "description": "Endpoint para cadastrar treinadores no banco de dados.",
        "responses": {
          "201": {
            "description": "Treinador criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Treinador criado com sucesso!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrainerDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{trainerId}/captures": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Captura um Pokémon",
        "description": "Endpoint para capturar um Pokémon consultando a PokéAPI e associando ao treinador.",
        "parameters": [
          {
            "name": "trainerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do treinador"
          }
        ],
        "responses": {
          "201": {
            "description": "Pokémon capturado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon capturado com sucesso!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CapturedPokemon"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload inválido ou limite de 6 Pokémons atingido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Treinador ou Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapturePokemonDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{trainerId}/team": {
      "get": {
        "tags": [
          "Trainers"
        ],
        "summary": "Lista o time atual do treinador",
        "description": "Endpoint para listar Pokémons ativos no time do treinador.",
        "parameters": [
          {
            "name": "trainerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do treinador"
          }
        ],
        "responses": {
          "200": {
            "description": "Time atual retornado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CapturedPokemon"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Charmander"
          },
          "type": {
            "type": "array",
            "example": [
              "fire"
            ],
            "items": {
              "type": "string"
            }
          },
          "level": {
            "type": "number",
            "example": 5
          },
          "evolution": {
            "type": "number",
            "example": 1
          }
        }
      },
      "CreatePokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Charmander"
          },
          "type": {
            "type": "array",
            "example": [
              "fire"
            ],
            "items": {
              "type": "string"
            }
          },
          "level": {
            "type": "number",
            "example": 5
          },
          "evolution": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "name",
          "type",
          "level",
          "evolution"
        ]
      },
      "UpdatePokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Charmeleon"
          },
          "type": {
            "type": "array",
            "example": [
              "fire"
            ],
            "items": {
              "type": "string"
            }
          },
          "level": {
            "type": "number",
            "example": 16
          },
          "evolution": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "name",
          "type",
          "level",
          "evolution"
        ]
      },
      "PokeApiPokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "pikachu"
          },
          "imageUrl": {
            "type": "string",
            "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
          },
          "types": {
            "type": "array",
            "example": [
              "electric"
            ],
            "items": {
              "type": "string"
            }
          },
          "baseExperience": {
            "type": "number",
            "example": 112
          },
          "stats": {
            "type": "object",
            "properties": {
              "hp": {
                "type": "number",
                "example": 35
              },
              "attack": {
                "type": "number",
                "example": 55
              },
              "defense": {
                "type": "number",
                "example": 40
              },
              "speed": {
                "type": "number",
                "example": 90
              }
            }
          }
        }
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Ash"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-09T14:00:00.000Z"
          }
        }
      },
      "CreateTrainerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ash"
          }
        },
        "required": [
          "name"
        ]
      },
      "CapturePokemonDto": {
        "type": "object",
        "properties": {
          "pokemonName": {
            "type": "string",
            "example": "pikachu"
          }
        },
        "required": [
          "pokemonName"
        ]
      },
      "CapturedPokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "trainerId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "pokemonName": {
            "type": "string",
            "example": "pikachu"
          },
          "imageUrl": {
            "type": "string",
            "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
          },
          "types": {
            "type": "array",
            "example": [
              "electric"
            ],
            "items": {
              "type": "string"
            }
          },
          "baseExperience": {
            "type": "number",
            "example": 112
          },
          "stats": {
            "type": "object",
            "properties": {
              "hp": {
                "type": "number",
                "example": 35
              },
              "attack": {
                "type": "number",
                "example": 55
              },
              "defense": {
                "type": "number",
                "example": 40
              },
              "speed": {
                "type": "number",
                "example": 90
              }
            }
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-09T14:00:00.000Z"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Pokémon não encontrado."
          }
        }
      }
    }
  }
}